    "url": "https://github.com/e-cline/res-experiments/issues"
  },
  "license": "MIT",
  "author": "Ethan Cline",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/e-cline/res-experiments.git",
    "directory": "packages/res_signal_maps"
  },
  "files": [
    "rescript.json",
    "src/**/*.res",
    "src/**/*.resi"
  ],
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"

// Canary (plan, verified point 2): without the PPX, the compiler ignores `@weft.component`, the
// component gets no `props` type, and using it is a type error. Compiled without the PPX.
@@jsxConfig({version: 4, module_: "MyJsx"})
module MyJsx = {
  type element
  type component<'props> = 'props => element
  let jsx = (component: component<'props>, props: 'props): element => component(props)
  external string: string => element = "%identity"
}
module Label = {
  @weft.component
  let make = (~text: string) => MyJsx.string(text)
}
let element = <Label text="hi" />

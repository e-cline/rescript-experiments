node_modules
dist

# res-bench's recordings and the bundles it builds from earlier commits (see
# tools/benchmarking).
.bench

*.log
.DS_Store

tsconfig.vitest-temp.json

# ReScript compiler artifacts: `lib/` is Rewatch's intermediate build cache
# (.cmi/.cmj/.ast, kept even with "in-source": true output), and *.gen.tsx are
# the genType-emitted TS files it writes alongside `.res`/`.resi` source. Both
# are regenerated by `rescript build`. The compiled JS it writes there
# (*.res.js, or *.res.jsx in a package with preserved JSX) is committed instead, so the
# output of a change is reviewable; CI checks it is up to date.
lib
*.gen.tsx

# Playwright's output (examples/weft_notes/e2e).
test-results
playwright-report

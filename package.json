{
  "name": "@e-cline/rescript-experiments",
  "version": "0.0.1",
  "private": true,
  "description": "Experiments authoring packages in ReScript",
  "homepage": "https://github.com/e-cline/rescript-experiments",
  "bugs": {
    "url": "https://github.com/e-cline/rescript-experiments/issues"
  },
  "license": "MIT",
  "author": "Ethan Cline",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/e-cline/rescript-experiments.git"
  },
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "test": "vp run -r test",
    "bench": "vp run -r bench",
    "size": "vp run -r size",
    "fmt": "vp fmt && vp run -r res:fmt",
    "check": "vp check && vp run -r res:check",
    "prepare": "vp config",
    "typecheck": "vp run -r typecheck",
    "rescript:clean": "vp run -r res:clean",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@e-cline/benchmarking": "workspace:*",
    "@e-cline/common": "workspace:*",
    "@e-cline/http_server_example": "workspace:*",
    "@e-cline/pretty_print_example": "workspace:*",
    "@e-cline/priority_queue": "workspace:*",
    "@e-cline/server": "workspace:*",
    "@e-cline/signal_maps": "workspace:*",
    "@e-cline/signal_maps_benchmarks": "workspace:*",
    "@e-cline/signals": "workspace:*",
    "@e-cline/signals_benchmarks": "workspace:*",
    "@e-cline/tree_shaking_example": "workspace:*",
    "@e-cline/trees": "workspace:*",
    "@e-cline/trees_benchmarks": "workspace:*",
    "@e-cline/weft": "workspace:*",
    "@e-cline/weft_app_example": "workspace:*",
    "@e-cline/weft_core": "workspace:*",
    "@e-cline/weft_core_benchmarks": "workspace:*",
    "@e-cline/weft_dom": "workspace:*",
    "@e-cline/weft_signals": "workspace:*",
    "@types/node": "catalog:",
    "jsdom": "catalog:",
    "rescript": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.8.2"
}

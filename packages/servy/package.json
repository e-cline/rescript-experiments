{
  "name": "@e-cline/servy",
  "version": "0.0.1",
  "description": "A small ReScript framework for HTTP servers built on the Web-standard Request/Response APIs, composed from handlers, middleware and routes and set up as one pipe: routes with paths as lists of segments, typed query parameters, HTML/text/JSON/streaming responses, cookies, CORS, and typed values attached to the request. Runs on Node via @hono/node-server.",
  "keywords": [
    "hono",
    "http",
    "middleware",
    "rescript",
    "router",
    "server",
    "servy"
  ],
  "homepage": "https://github.com/e-cline/rescript-experiments/tree/main/packages/servy#readme",
  "bugs": {
    "url": "https://github.com/e-cline/rescript-experiments/issues"
  },
  "license": "MIT",
  "author": "Ethan Cline",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/e-cline/rescript-experiments.git",
    "directory": "packages/servy"
  },
  "files": [
    "rescript.json",
    "src/**/*.res",
    "src/**/*.resi"
  ],
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@rescript/webapi": "catalog:",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@rescript/runtime": "catalog:",
    "rescript": "catalog:",
    "rescript-vitest": "catalog:"
  },
  "peerDependencies": {
    "@rescript/runtime": ">=12.0.0 <13",
    "rescript": ">=12.0.0 <13"
  },
  "engines": {
    "node": ">=22"
  }
}

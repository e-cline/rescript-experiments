opam-version: "2.0"
name: "rescript_ppx"
version: "dev"
synopsis: "The toolchain the workspace's ReScript PPXs build with"
depends: [
  "base-bigarray" {= "base"}
  "base-domains" {= "base"}
  "base-effects" {= "base"}
  "base-nnp" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "dune" {= "3.24.2"}
  "ocaml" {= "5.3.0"}
  "ocaml-base-compiler" {= "5.3.0"}
  "ocaml-compiler" {= "5.3.0"}
  "ocaml-compiler-libs" {= "v0.17.0"}
  "ocaml-config" {= "3"}
  "ocaml-options-vanilla" {= "1"}
  "ppx_derivers" {= "1.2.1"}
  "ppxlib" {= "0.34.0"}
  "sexplib0" {= "v0.17.0"}
  "stdlib-shims" {= "0.3.0"}
]
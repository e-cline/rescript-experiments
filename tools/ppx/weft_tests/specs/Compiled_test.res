/***
Assertions on the compiled output of the fixtures, for what the Vite plugin and the client rely on.
(The output is committed, so any other change to it shows up in review, and CI fails if a build
changes it.)
*/

open Vitest

let compiled = name =>
  NodeSupport.readFileSync(NodeSupport.join(NodeSupport.packageRoot, `fixtures/${name}.res.js`))

let firstLine = name => compiled(name)->String.split("\n")->Array.get(0)

describe("the compiled fixtures", () => {
  test("a file's @@directive is its first line, as written", t => {
    t->expect(firstLine("Directive"))->Expect.toBe(Some("'use canary'"))
  })

  test("a file with server components starts with the server directive", t => {
    t->expect(firstLine("ServerComponents"))->Expect.toBe(Some("'use weft server'"))
  })

  test("a file with entrypoints starts with the entrypoint directive", t => {
    t->expect(firstLine("Entrypoints"))->Expect.toBe(Some("'use weft entrypoint'"))
    t->expect(firstLine("WithInterface"))->Expect.toBe(Some("'use weft entrypoint'"))
    t->expect(firstLine("DomJsx"))->Expect.toBe(Some("'use weft entrypoint'"))
  })

  test("a file declaring RPCs has a directive for each, beside any entrypoint one", t => {
    let lines = name => compiled(name)->String.split("\n")
    t
    ->expect(lines("Rpcs")->Array.slice(~start=0, ~end=4))
    ->Expect.toEqual([
      "'use weft rpc notes.save'",
      "'use weft rpc notes.rename_2'",
      "'use weft rpc Billing.refund'",
      "// Generated by ReScript, PLEASE EDIT WITH CARE",
    ])
    t
    ->expect(lines("EntrypointsAndRpcs")->Array.slice(~start=0, ~end=2))
    ->Expect.toEqual(["'use weft entrypoint'", "'use weft rpc likes.like'"])
  })

  test("@weft.rpc passes the ID to Rpc.make and Rpc.makePrepared, as `~id`", t => {
    t->expect(Rpcs.save->WeftServer.Rpc.id)->Expect.toBe("notes.save")
    t->expect(Rpcs.Nested.rename->WeftServer.Rpc.id)->Expect.toBe("notes.rename_2")
    t->expect(Rpcs.refund->WeftServer.Rpc.id)->Expect.toBe("Billing.refund")
    t->expect(EntrypointsAndRpcs.like->WeftServer.Rpc.id)->Expect.toBe("likes.like")
  })

  test("a file with @@weft.server starts with the server directive", t => {
    t->expect(firstLine("ServerOnly"))->Expect.toBe(Some("'use weft server'"))
  })

  test("a file with neither has no directive", t => {
    t
    ->expect(firstLine("Shared"))
    ->Expect.toBe(Some("// Generated by ReScript, PLEASE EDIT WITH CARE"))
    t
    ->expect(firstLine("Page"))
    ->Expect.toBe(Some("// Generated by ReScript, PLEASE EDIT WITH CARE"))
  })

  test("a file-level component is exported as `make`, and nested ones by module name", t => {
    let js = compiled("Entrypoints")
    t->expect(js->String.includes("  make,\n"))->Expect.toBe(true)
    t->expect(js->String.includes("  Nested,\n"))->Expect.toBe(true)
    t->expect(js->String.includes("  Outer,\n"))->Expect.toBe(true)
  })

  test("a module named after a JavaScript global is exported as `$$<name>`", t => {
    t->expect(compiled("Entrypoints")->String.includes("  $$Error,\n"))->Expect.toBe(true)
  })
})

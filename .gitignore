dist

# res-bench's recordings and the bundles it builds from earlier commits (see
# tools/benchmarking).
.bench

*.log
.DS_Store

tsconfig.vitest-temp.json

# ReScript compiler artifacts: `lib/` is Rewatch's intermediate build cache
# (.cmi/.cmj/.ast, kept even with "in-source": true output); *.res.js (or
# *.res.jsx, in a package with JSX) and *.gen.tsx are the compiled JS and
# genType-emitted TS files it writes alongside `.res`/`.resi` source -- all
# regenerated by `rescript build`, none meant to be committed.
lib
*.res.js
*.res.jsx
*.gen.tsx

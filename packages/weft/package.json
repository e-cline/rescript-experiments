{
  "name": "@e-cline/weft",
  "version": "0.0.1",
  "description": "Weft: a React-like UI framework in ReScript. One package with the public API of @e-cline/weft_core and the DOM renderer.",
  "keywords": [
    "dom",
    "jsx",
    "rescript",
    "ui",
    "weft"
  ],
  "homepage": "https://github.com/e-cline/rescript-experiments/tree/main/packages/weft#readme",
  "bugs": {
    "url": "https://github.com/e-cline/rescript-experiments/issues"
  },
  "license": "MIT",
  "author": "Ethan Cline",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/e-cline/rescript-experiments.git",
    "directory": "packages/weft"
  },
  "files": [
    "rescript.json",
    "src/**/*.res",
    "src/**/*.resi"
  ],
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@e-cline/weft_core": "workspace:^",
    "@e-cline/weft_dom": "workspace:^"
  },
  "devDependencies": {
    "@rescript/runtime": "catalog:",
    "jsdom": "catalog:",
    "rescript": "catalog:",
    "rescript-vitest": "catalog:"
  },
  "peerDependencies": {
    "@rescript/runtime": ">=12.0.0 <13",
    "rescript": ">=12.0.0 <13"
  },
  "engines": {
    "node": ">=22"
  }
}
